# Gemini API key. Keep server-side; never prefix this with VITE_.
GEMINI_API_KEY=""

# Supabase project connection.
# The VITE_ variables are public and safe for the browser when they contain a publishable key only.
VITE_SUPABASE_URL="https://babdeawtwaoorsmdnxip.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Server-side names used by Express. Use the same project URL and publishable key.
SUPABASE_URL="https://babdeawtwaoorsmdnxip.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
